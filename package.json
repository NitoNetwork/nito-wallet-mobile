{
  "name": "nito-wallet-mobile",
  "version": "2.0.2",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "type": "module",
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-modules-core"
        ]
      },
      "android": {
        "buildFromSource": [
          "expo-file-system",
          "expo-screen-capture"
        ]
      }
    }
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "version": "npm run release:sync",
    "release:sync": "node scripts/sync-release-version.mjs",
    "release:check": "node scripts/sync-release-version.mjs --check",
    "prelint": "npm run release:check",
    "eas-build-pre-install": "node scripts/ensure-rust-toolchains.mjs",
    "rust:fmt": "cargo fmt --manifest-path native/nito-wallet-crypto/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path native/nito-wallet-crypto/Cargo.toml --all-targets --locked -- -D warnings",
    "rust:test": "cargo test --manifest-path native/nito-wallet-crypto/Cargo.toml --lib --locked",
    "doctor": "expo-doctor",
    "warnings:self-test": "node scripts/assert-warning-free.mjs --self-test",
    "warnings:ios-self-test": "node scripts/assert-ios-owned-warning-free.mjs --self-test",
    "warnings:ios-pods-self-test": "node scripts/assert-ios-pod-sdk58-warning-policy.mjs --self-test",
    "warnings:gradle-self-test": "node scripts/assert-gradle-sdk58-warning-policy.mjs --self-test",
    "warnings:source": "node scripts/assert-no-warning-suppressions.mjs",
    "audit:production": "node scripts/audit-production-dependencies.mjs",
    "audit:ruby-build": "node scripts/audit-ruby-build-dependencies.mjs",
    "audit:ruby-build:self-test": "node scripts/audit-ruby-build-dependencies.mjs --self-test",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:free:prebuild": "node scripts/prebuild-ios-free.mjs",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "eas:login": "npx eas-cli@20.2.0 login",
    "eas:init": "npx eas-cli@20.2.0 init",
    "build:apk": "npx eas-cli@20.2.0 build --platform android --profile preview",
    "build:ipa": "npx eas-cli@20.2.0 build --platform ios --profile production",
    "build:android:preview": "npx eas-cli@20.2.0 build --platform android --profile preview",
    "build:ios:preview": "npx eas-cli@20.2.0 build --platform ios --profile preview",
    "build:android:store": "npx eas-cli@20.2.0 build --platform android --profile production",
    "build:ios:store": "npx eas-cli@20.2.0 build --platform ios --profile production",
    "build:all:store": "npx eas-cli@20.2.0 build --platform all --profile production",
    "submit:android": "npx eas-cli@20.2.0 submit --platform android --profile production --latest",
    "submit:ios": "npx eas-cli@20.2.0 submit --platform ios --profile production --latest"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@scure/bip39": "2.2.0",
    "@scure/btc-signer": "^2.2.0",
    "bech32": "^2.0.0",
    "expo": "58.0.25",
    "expo-asset": "~58.0.21",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-file-system": "~58.0.13",
    "expo-font": "58.0.12",
    "expo-local-authentication": "~58.0.3",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-qrcode-svg": "file:vendor/react-native-qrcode-svg",
    "react-native-safe-area-context": "~5.11.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@scure/bip32": "2.2.0",
    "@types/node": "26.1.1",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.25",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-import-resolver-typescript": "4.4.5",
    "expo-doctor": "^1.21.6",
    "globals": "^16.0.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@expo/cli": {
      "glob": "14.0.4"
    },
    "@expo/fingerprint": {
      "glob": "14.0.4",
      "minimatch": "11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@^5": "5.0.12",
    "eslint-import-resolver-typescript": "4.4.5",
    "js-yaml": "4.3.2",
    "postcss": "8.5.32",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "zod": "4.6.7"
  }
}
