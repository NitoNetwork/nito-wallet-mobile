source 'https://rubygems.org'

ruby '>= 3.4.0', '< 3.5.0'
gem 'cocoapods', '1.17.0'
gem 'xcodeproj', '1.28.1'

# Security floor for CocoaPods URI handling during iOS dependency resolution.
gem 'addressable', '2.9.2'

# Keep the Ruby build-tool audit reproducible in CI and local release checks.
gem 'bundler-audit', '0.9.3', require: false

# ActiveSupport 7.2 used by CocoaPods passes quirks_mode, removed in json 3.
gem 'json', '< 3.0'
